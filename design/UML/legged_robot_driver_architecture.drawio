          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="2. 62" value="&lt;b&gt;B1 + Z1 robot&lt;/b&gt;" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.1;size=12;fontSize=12;fillColor=#eeeeee;" vertex="1" parent="1">
